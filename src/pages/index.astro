---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { ArrowDown, Compass, Wind, Map } from 'lucide-astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = posts.slice(0, 3);
---

<BaseLayout title="Trang chủ">
	<!-- Luxury Hero Section -->
	<section class="relative h-[95vh] flex items-center justify-center overflow-hidden">
		<div class="absolute inset-0">
			<img 
				src="https://images.unsplash.com/photo-1523987355523-c7b5b0dd90a7?q=80&w=2500&auto=format&fit=crop" 
				alt="Hero camping" 
				class="w-full h-full object-cover scale-105"
			/>
			<div class="absolute inset-0 bg-primary-950/40 backdrop-brightness-75"></div>
		</div>
		
		<div class="container mx-auto px-6 relative z-10 text-center">
			<div class="inline-flex items-center gap-2 px-4 py-2 glass rounded-full text-white text-[10px] font-black uppercase tracking-[0.3em] mb-8 animate-fade-in">
				<Compass class="w-4 h-4 text-accent-500" /> Hành trình khám phá Việt Nam
			</div>
			<h1 class="text-6xl md:text-8xl font-black text-white mb-8 tracking-tighter leading-[0.9] max-w-5xl mx-auto">
				Hòa mình vào <span class="italic text-primary-200">Thiên nhiên</span> Đại ngàn.
			</h1>
			<p class="text-xl text-white/80 mb-12 max-w-2xl mx-auto font-medium leading-relaxed">
				Trại Việt chia sẻ những câu chuyện về sự tự do, những tọa độ cắm trại bí mật và phong cách sống dã ngoại hiện đại.
			</p>
			
			<div class="flex flex-col sm:flex-row items-center justify-center gap-6">
				<a href="/category/dia-diem" class="px-10 py-5 bg-white text-primary-950 font-black rounded-3xl hover:scale-105 transition-transform shadow-2xl flex items-center gap-2 uppercase tracking-tighter">
					Bắt đầu khám phá <Wind class="w-5 h-5" />
				</a>
				<button class="flex items-center gap-4 text-white font-bold group">
					<div class="p-4 glass rounded-full group-hover:bg-white/20 transition-all">
						<ArrowDown class="w-5 h-5" />
					</div>
					Kéo xuống xem thêm
				</button>
			</div>
		</div>

		<!-- Subtle Decor -->
		<div class="absolute bottom-10 left-10 hidden xl:block">
			<div class="text-[100px] font-black text-white/5 tracking-tighter leading-none">01</div>
		</div>
	</section>

	<!-- Minimal Stats -->
	<section class="py-12 glass relative z-20 -mt-10 mx-6 rounded-[3rem] shadow-2xl">
		<div class="container mx-auto px-6">
			<div class="grid grid-cols-2 md:grid-cols-4 gap-12 text-center divide-x divide-white/10">
				<div>
					<div class="text-4xl font-black text-gradient">20+</div>
					<div class="text-[10px] font-black uppercase tracking-widest text-natural-400 mt-2">Địa điểm</div>
				</div>
				<div>
					<div class="text-4xl font-black text-gradient">15k</div>
					<div class="text-[10px] font-black uppercase tracking-widest text-natural-400 mt-2">Cộng đồng</div>
				</div>
				<div>
					<div class="text-4xl font-black text-gradient">09+</div>
					<div class="text-[10px] font-black uppercase tracking-widest text-natural-400 mt-2">Review thật</div>
				</div>
				<div>
					<div class="text-4xl font-black text-gradient">24/7</div>
					<div class="text-[10px] font-black uppercase tracking-widest text-natural-400 mt-2">Hỗ trợ</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Featured Section -->
	<section class="py-32">
		<div class="container mx-auto px-6">
			<div class="flex flex-col md:flex-row items-end justify-between mb-20 gap-8">
				<div class="max-w-xl">
					<div class="text-primary-500 font-black text-xs uppercase tracking-[0.4em] mb-4">Góc cảm hứng</div>
					<h2 class="text-5xl font-black tracking-tighter leading-none">
						Gần đây trên <span class="text-gradient underline decoration-primary-500/20 underline-offset-8">Journal.</span>
					</h2>
				</div>
				<p class="text-natural-500 dark:text-natural-400 max-w-sm text-sm font-medium leading-relaxed">
					Những bài viết được tuyển chọn kỹ lưỡng về địa điểm, trang bị và kỹ năng giúp bạn nâng tầm trải nghiệm cắm trại.
				</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
				{featuredPosts.map((post) => (
					<BlogCard post={post} />
				))}
			</div>

			<div class="mt-20 flex justify-center">
				<a href="/category/dia-diem" class="group px-8 py-4 border-2 border-natural-200 dark:border-natural-800 rounded-2xl font-black text-sm uppercase tracking-widest hover:border-primary-500 transition-all flex items-center gap-3">
					Tất cả câu chuyện <Map class="w-4 h-4 group-hover:rotate-12 transition-transform" />
				</a>
			</div>
		</div>
	</section>

	<!-- Interactive CTA -->
	<section class="py-32 bg-primary-950 overflow-hidden relative">
		<div class="container mx-auto px-6 relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
				<div>
					<h2 class="text-6xl font-black text-white tracking-tighter leading-[0.9] mb-8">
						Cùng Trại Việt định nghĩa lại <span class="italic text-primary-400 underline decoration-primary-400/30">Tự do.</span>
					</h2>
					<p class="text-lg text-primary-200 mb-12 leading-relaxed">
						Đăng ký nhận bản tin định kỳ về các tọa độ bí mật và ưu đãi thiết bị cắm trại chuyên dụng chỉ dành cho thành viên.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<input 
							type="email" 
							placeholder="Email của bạn..." 
							class="flex-grow px-8 py-5 bg-white/5 border border-white/10 rounded-3xl text-white focus:outline-none focus:ring-2 focus:ring-primary-400"
						/>
						<button class="px-8 py-5 bg-primary-400 text-primary-950 font-black rounded-3xl hover:bg-white transition-colors uppercase text-sm tracking-tighter">
							Tham gia ngay
						</button>
					</div>
				</div>
				<div class="relative">
					<div class="aspect-square rounded-[4rem] overflow-hidden rotate-3 hover:rotate-0 transition-transform duration-700 shadow-2xl">
						<img src="https://images.unsplash.com/photo-1533873984035-25970ab07461?q=80&w=1000&auto=format&fit=crop" alt="Camping" class="w-full h-full object-cover" />
					</div>
					<!-- Float card -->
					<div class="absolute -bottom-10 -left-10 glass p-8 rounded-3xl shadow-2xl animate-bounce-slow">
						<div class="flex items-center gap-4">
							<div class="w-12 h-12 bg-accent-500 rounded-2xl flex items-center justify-center text-white font-black text-xl">
								9+
							</div>
							<div>
								<div class="text-xs font-black uppercase tracking-widest text-natural-400">Bài viết</div>
								<div class="font-black">Đã xuất bản</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	@keyframes fade-in {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fade-in 1s ease-out forwards;
	}
	.animate-bounce-slow {
		animation: bounce 3s infinite;
	}
	@keyframes bounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}
</style>
