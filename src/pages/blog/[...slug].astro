---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Calendar, User, Clock, Share2, Facebook, Twitter, MessageCircle } from "lucide-astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

const post = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, author, heroImage, category } = post.data;

const formattedDate = pubDate.toLocaleDateString("vi-VN", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

// Calculate reading time (mock)
const readingTime = Math.ceil((post.body || "").split(" ").length / 200) || 2;
---

<BaseLayout title={title} description={description} image={heroImage}>
	<article class="py-12 md:py-20">
		<div class="container mx-auto px-4">
			<!-- Header -->
			<header class="max-w-4xl mx-auto mb-12 text-center">
				<div class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 text-sm font-bold mb-6">
					{category}
				</div>
				<h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
					{title}
				</h1>
				<div class="flex flex-wrap items-center justify-center gap-6 text-natural-500 dark:text-natural-400">
					<span class="flex items-center gap-2">
						<User class="w-4 h-4" /> {author}
					</span>
					<span class="flex items-center gap-2">
						<Calendar class="w-4 h-4" /> {formattedDate}
					</span>
					<span class="flex items-center gap-2">
						<Clock class="w-4 h-4" /> {readingTime} phút đọc
					</span>
				</div>
			</header>

			<!-- Hero Image -->
			<div class="max-w-6xl mx-auto mb-16 rounded-[2rem] overflow-hidden shadow-2xl">
				<img src={heroImage} alt={title} class="w-full aspect-[21/9] object-cover" />
			</div>

			<!-- Content Wrapper -->
			<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12">
				<!-- Sidebar TOC -->
				<aside class="hidden lg:block lg:col-span-3 sticky top-24 self-start">
					<div class="p-6 rounded-2xl bg-natural-100 dark:bg-natural-900/50 border border-natural-200 dark:border-natural-800">
						<h3 class="font-bold mb-4 flex items-center gap-2">
							Mục lục
						</h3>
						<nav class="space-y-3 text-sm">
							{headings.map((h) => (
								<a 
									href={`#${h.slug}`} 
									class={`block text-natural-600 dark:text-natural-400 hover:text-primary-600 transition-colors ${h.depth === 3 ? "pl-4" : "font-medium"}`}
								>
									{h.text}
								</a>
							))}
						</nav>
					</div>
				</aside>

				<!-- Main Content -->
				<div class="lg:col-span-6">
					<div class="prose prose-lg dark:prose-invert prose-headings:font-bold prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-img:rounded-2xl">
						<Content />
					</div>

					<!-- Social Share -->
					<div class="mt-16 pt-8 border-t border-natural-200 dark:border-natural-800 flex flex-col sm:flex-row items-center justify-between gap-6">
						<div class="flex items-center gap-4">
							<span class="font-bold flex items-center gap-2"><Share2 class="w-4 h-4" /> Chia sẻ:</span>
							<div class="flex gap-2">
								<a href="#" class="p-2 rounded-full bg-[#1877F2] text-white hover:opacity-80 transition-opacity"><Facebook class="w-4 h-4" /></a>
								<a href="#" class="p-2 rounded-full bg-[#1DA1F2] text-white hover:opacity-80 transition-opacity"><Twitter class="w-4 h-4" /></a>
								<a href="#" class="p-2 rounded-full bg-[#0068FF] text-white hover:opacity-80 transition-opacity"><MessageCircle class="w-4 h-4" /></a>
							</div>
						</div>
						<div class="flex flex-wrap gap-2">
							{post.data.tags?.map((tag) => (
								<span class="px-3 py-1 bg-natural-100 dark:bg-natural-800 rounded-lg text-sm">#{tag}</span>
							))}
						</div>
					</div>
				</div>

				<!-- Author Card / Related (Mock) -->
				<aside class="lg:col-span-3 space-y-8">
					<div class="p-8 rounded-2xl bg-primary-950 text-white">
						<h3 class="font-bold mb-4">Về tác giả</h3>
						<div class="flex items-center gap-4 mb-4">
							<div class="w-12 h-12 rounded-full bg-primary-600 flex items-center justify-center font-bold">
								{author.charAt(0)}
							</div>
							<span class="font-bold">{author}</span>
						</div>
						<p class="text-sm text-primary-200 leading-relaxed">
							Một người yêu thiên nhiên và thích khám phá những cung đường mới.
						</p>
					</div>
				</aside>
			</div>
		</div>
	</article>
</BaseLayout>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
</style>
