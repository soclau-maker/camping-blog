---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Mountain, Users, Heart, Target } from 'lucide-astro';

const stats = [
	{ label: 'Bài viết', value: '100+', icon: Mountain },
	{ label: 'Độc giả', value: '10k+', icon: Users },
	{ label: 'Đánh giá', value: '50+', icon: Heart },
	{ label: 'Địa điểm', value: '30+', icon: Target },
];
---

<BaseLayout title="Giới thiệu">
	<section class="py-20 bg-white dark:bg-natural-950">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto">
				<h1 class="text-4xl md:text-6xl font-bold mb-8 text-center">Chúng tôi là <span class="text-primary-600">Trại Việt</span></h1>
				<p class="text-xl text-natural-600 dark:text-natural-400 text-center mb-16 leading-relaxed">
					Nơi hội tụ những tâm hồn yêu tự do, khát khao khám phá những góc nhỏ hoang sơ của dải đất hình chữ S thông qua những chuyến đi cắm trại đầy cảm hứng.
				</p>
				
				<div class="aspect-[21/9] rounded-[2rem] overflow-hidden mb-20 shadow-xl">
					<img src="https://images.unsplash.com/photo-1533873984035-25970ab07461?q=80&w=1500&auto=format&fit=crop" alt="Team camping" class="w-full h-full object-cover" />
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-20">
					<div>
						<h2 class="text-3xl font-bold mb-6">Sứ mệnh của chúng tôi</h2>
						<p class="text-natural-600 dark:text-natural-400 leading-relaxed mb-4">
							Trại Việt ra đời với mong muốn xây dựng một cộng đồng cắm trại văn minh, bền vững tại Việt Nam. Chúng tôi tin rằng việc kết nối với thiên nhiên là cách tốt nhất để cân bằng cuộc sống hiện đại đầy áp lực.
						</p>
						<p class="text-natural-600 dark:text-natural-400 leading-relaxed">
							Thông qua việc chia sẻ những kiến thức thực tế và địa điểm chính xác, chúng tôi hy vọng mọi người sẽ có những chuyến đi an toàn, thú vị và đặc biệt là biết cách bảo vệ môi trường.
						</p>
					</div>
					<div>
						<h2 class="text-3xl font-bold mb-6">Tại sao chọn Trại Việt?</h2>
						<ul class="space-y-4">
							<li class="flex items-start gap-4">
								<div class="mt-1 w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-600 shrink-0">✓</div>
								<p class="text-natural-600 dark:text-natural-400">Thông tin địa điểm được kiểm chứng thực tế.</p>
							</li>
							<li class="flex items-start gap-4">
								<div class="mt-1 w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-600 shrink-0">✓</div>
								<p class="text-natural-600 dark:text-natural-400">Đánh giá thiết bị khách quan, không quảng cáo sai sự thật.</p>
							</li>
							<li class="flex items-start gap-4">
								<div class="mt-1 w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-600 shrink-0">✓</div>
								<p class="text-natural-600 dark:text-natural-400">Cập nhật xu hướng cắm trại mới nhất trên thế giới.</p>
							</li>
						</ul>
					</div>
				</div>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-12 border-y border-natural-200 dark:border-natural-800">
					{stats.map((s) => (
						<div class="text-center">
							<div class="flex justify-center mb-4">
								<s.icon class="w-8 h-8 text-primary-600" />
							</div>
							<div class="text-3xl font-bold mb-1">{s.value}</div>
							<div class="text-sm text-natural-500">{s.label}</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
