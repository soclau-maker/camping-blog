---
import { Calendar, ArrowUpRight } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, heroImage, category } = post.data;

const formattedDate = pubDate.toLocaleDateString('vi-VN', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
---

<article class="group relative flex flex-col h-full hover-lift">
	<div class="relative aspect-[4/5] overflow-hidden rounded-[2.5rem] mb-6 shadow-2xl shadow-primary-950/10">
		<img 
			src={heroImage} 
			alt={title} 
			class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-primary-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
		
		<div class="absolute top-6 left-6">
			<span class="px-5 py-2 glass rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-primary-950 dark:text-white">
				{category}
			</span>
		</div>

		<div class="absolute bottom-8 left-8 right-8 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
			<a href={`/blog/${post.id}`} class="w-full py-4 bg-white text-primary-950 rounded-2xl font-bold flex items-center justify-center gap-2 shadow-2xl">
				Xem bài viết <ArrowUpRight class="w-4 h-4" />
			</a>
		</div>
	</div>
	
	<div class="px-2">
		<div class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-widest text-natural-400 mb-3">
			<Calendar class="w-3.5 h-3.5" />
			{formattedDate}
		</div>
		
		<h3 class="text-2xl font-bold leading-tight tracking-tight group-hover:text-primary-500 transition-colors">
			<a href={`/blog/${post.id}`}>{title}</a>
		</h3>
	</div>
</article>
