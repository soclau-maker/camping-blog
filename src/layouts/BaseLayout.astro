---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = 'Blog chia sẻ kinh nghiệm và địa điểm cắm trại tại Việt Nam', image = '/placeholder-social.jpg' } = Astro.props;
---

<!doctype html>
<html lang="vi" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />

		<title>{title} | Trại Việt Blog</title>
		<meta name="title" content={`${title} | Trại Việt Blog`} />
		<meta name="description" content={description} />

		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			if (theme === 'dark') document.documentElement.classList.add('dark');
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="font-sans">
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
